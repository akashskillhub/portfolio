# SKILLHUB APPLICATION CONFIGURATION
SKILLHUB_APP_NAME="SKILLHUB Portfolio"
SKILLHUB_APP_AUTHOR="Akash Dhone"
SKILLHUB_APP_URL="http://localhost:3000"
SKILLHUB_APP_VERSION="1.0.0"

# DATABASE (MongoDB Atlas or Local MongoDB Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillhub_portfolio?retryWrites=true&w=majority
SKILLHUB_MONGODB_URI=""

# AUTHENTICATION (Random 32+ character hex or base64 secret for JWT encryption)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SKILLHUB_AUTH_SECRET=""

# CLOUDINARY MEDIA STORAGE (MANDATORY for Profile Images, Screenshots, and Resume PDF Uploads)
# Sign up free at: https://cloudinary.com
SKILLHUB_CLOUDINARY_CLOUD_NAME=""
SKILLHUB_CLOUDINARY_API_KEY=""
SKILLHUB_CLOUDINARY_API_SECRET=""

# EMAIL SERVICE - GMAIL SMTP (For contact form notifications & auto-responder)
# Generate Google App Password at: https://myaccount.google.com/apppasswords
SKILLHUB_GMAIL_USER=""
SKILLHUB_GMAIL_APP_PASSWORD=""

# OPTIONAL SETTINGS
SKILLHUB_ADMIN_EMAIL=""
SKILLHUB_DEFAULT_THEME="system"
